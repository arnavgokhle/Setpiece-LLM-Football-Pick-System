# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ───────────────────────────────────────────────
# Project URL and anon key are public by design (sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses row-level security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Models and search ─────────────────────────────────────
# Used for pick generation, finalization, grading, lineups and chat.
ANTHROPIC_API_KEY=
# Tavily web search: result grading, lineup/injury intel, chat news.
TAVILY_API_KEY=

# ── Football data (optional) ───────────────────────────────
# API-Football: squads and club stats. Free plan cannot access 2025+ seasons.
API_FOOTBALL_KEY=
# The Odds API: bookmaker prices for edge scores. Optional.
ODDS_API_KEY=

# ── Email (optional) ──────────────────────────────────────
RESEND_API_KEY=

# ── Payments (optional, not required to run the pipeline) ─
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=

# ── App ───────────────────────────────────────────────────
# Shared secret the scheduler sends as "Authorization: Bearer <value>"
# to /api/cron/daily and /api/picks/finalize. Generate a long random string.
FINALIZE_SECRET=
# Email address allowed into /admin. Required: there is no fallback.
ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Label recorded with each model call (e.g. "cron", "manual").
CLAUDE_TRIGGER=manual
