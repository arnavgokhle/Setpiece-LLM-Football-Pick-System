{
  "name": "setpiece",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "fetch-wc-data": "npx tsx --env-file=.env.local scripts/fetch-wc-data.ts",
    "seed-wc-fixtures": "npx tsx --env-file=.env.local scripts/seed-wc-fixtures.ts",
    "ingest-club-fixtures": "npx tsx --env-file=.env.local scripts/ingest-club-fixtures.ts",
    "seed-wc-players": "npx tsx --env-file=.env.local scripts/seed-wc-players.ts",
    "seed-tactical-profiles": "npx tsx --env-file=.env.local scripts/seed-tactical-profiles.ts",
    "seed-matchup-profiles": "npx tsx --env-file=.env.local scripts/seed-matchup-profiles.ts",
    "seed-set-pieces": "npx tsx --env-file=.env.local scripts/seed-set-pieces.ts",
    "seed-tournament-pressure": "npx tsx --env-file=.env.local scripts/seed-tournament-pressure.ts",
    "seed-player-roles": "npx tsx --env-file=.env.local scripts/seed-player-roles.ts",
    "seed-wc-analytics": "npm run seed-tactical-profiles && npm run seed-matchup-profiles && npm run seed-set-pieces && npm run seed-tournament-pressure && npm run seed-player-roles",
    "fetch-fbref-stats": "npx tsx --env-file=.env.local scripts/fetch-fbref-stats.ts",
    "fetch-fbref-international": "npx tsx --env-file=.env.local scripts/fetch-fbref-international.ts",
    "fetch-understat-stats": "npx tsx --env-file=.env.local scripts/fetch-understat-stats.ts",
    "fetch-real-stats": "npm run fetch-understat-stats && npm run fetch-fbref-international",
    "parse-fbref-csv": "npx tsx --env-file=.env.local scripts/parse-fbref-csv.ts",
    "fetch-club-stats": "npx tsx --env-file=.env.local scripts/fetch-club-stats.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.400.0",
    "next": "^16.2.6",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "@tailwindcss/typography": "^0.5.13",
    "cheerio": "^1.2.0",
    "eslint": "^8",
    "eslint-config-next": "^16.2.6",
    "vercel": "^54.4.1"
  }
}
